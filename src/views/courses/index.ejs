<%- include('../partials/head', { title }) %>
<%- include('../partials/pageHeader', {
  title,
  heading: 'Courses',
  subheading: 'Add your classes, then connect assignments to them.'
}) %>
<div class="content-grid course-page-grid">
  <section class="panel">
    <div class="panel-heading">
      <h2>Course list <span class="count-pill"><%= courses.length %></span></h2>
    </div>
    <% if (courses.length) { %>
      <div class="course-list">
        <% courses.forEach(course => { %>
          <div class="course-item">
            <div><strong><%= course.name %></strong><small><%= course.assignments ? course.assignments.length : 0 %> assignments</small></div>
            <form method="post" action="/courses/<%= course.id %>/delete" onsubmit="return confirm('Delete this course and its assignments?')">
              <button class="button button-danger" type="submit">Delete</button>
            </form>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <h3>No courses added</h3>
        <p>Add a course to start organizing your work.</p>
      </div>
    <% } %>
  </section>

  <section class="panel form-panel">
    <div class="panel-heading"><h2>Add a course</h2></div>
    <form method="post" action="/courses">
      <label class="field-label" for="name">Course name</label>
      <input id="name" name="name" placeholder="e.g. Web Development" maxlength="100" required>
      <button class="button button-primary full-button" type="submit">Add course</button>
    </form>
  </section>
</div>
<%- include('../partials/foot') %>
